{
  "kind": "collectionType",
  "collectionName": "guests",
  "info": {
    "singularName": "guest",
    "pluralName": "guests",
    "displayName": "Guest"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "customField",
      "private": true,
      "customField": "plugin::strapi-phone-validator-5.phone",
      "required": true
    },
    "assist": {
      "type": "enumeration",
      "private": true,
      "required": true,
      "default": "Pendiente",
      "enum": [
        "Pendiente",
        "Acepto",
        "Cancelo"
      ]
    },
    "invitation": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::invitation.invitation",
      "inversedBy": "guests"
    }
  }
}
